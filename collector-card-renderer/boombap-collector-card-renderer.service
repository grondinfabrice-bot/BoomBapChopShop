[Unit]
Description=BOOM BAP CHOP SHOP collector card renderer
After=network.target

[Service]
Type=simple
User=fabrice
Group=fabrice
WorkingDirectory=/var/www/sites/boombapchopshop/collector-card-renderer
EnvironmentFile=/etc/boombap-collector-card-renderer.env
ExecStart=/usr/bin/node /var/www/sites/boombapchopshop/collector-card-renderer/server.mjs
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
MemoryMax=256M

[Install]
WantedBy=multi-user.target
